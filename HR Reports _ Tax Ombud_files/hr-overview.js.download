// HR Overview page behaviour extracted from hr-overview.kml.php
(function () {
  const apiUrl = '../api/modules/hr/reports';
  const dateInput = document.getElementById('hrDateRange');
  const chartTypeDefault = document.getElementById('hrChartType');
  const btnApply = document.getElementById('hrApply');
  const btnReset = document.getElementById('hrReset');
  const rangeLabel = document.getElementById('hrRangeLabel');
  const chartTypeSelectors = Array.from(document.querySelectorAll('.hr-chart-type'));
  const allowedTypes = {
    hrStatusChart: ['bar', 'donut', 'pie'],
    hrDeptChart: ['bar', 'donut', 'pie'],
    hrLeaveTypeChart: ['bar', 'donut', 'pie'],
    hrLeaveTrendChart: ['area', 'line', 'bar'],
  };
  let picker = null;
  let cached = null;
  const charts = {};
  const defaultColors = ['#405189','#0ab39c','#f7b84b','#f06548','#299cdb','#6f42c1'];

  function sanitizeColors(colors, seriesLen = 1) {
    let base = Array.isArray(colors) && colors.length ? colors : defaultColors.slice();
    base = base.map((c, idx) => (c && c.trim()) ? c : defaultColors[idx % defaultColors.length]);
    while (base.length < seriesLen) {
      base.push(defaultColors[base.length % defaultColors.length]);
    }
    return base;
  }

  function formatDate(d) {
    if (!(d instanceof Date)) return '';
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function defaultRange() {
    const end = new Date();
    const start = new Date();
    start.setDate(end.getDate() - 29);
    return [start, end];
  }

  function getRange() {
    if (!picker || !picker.selectedDates.length) {
      const [s, e] = defaultRange();
      return { start: formatDate(s), end: formatDate(e) };
    }
    const [s, e] = picker.selectedDates;
    return { start: formatDate(s), end: formatDate(e || s) };
  }

  function getColors(id) {
    const el = document.getElementById(id);
    if (!el) return defaultColors;
    const attr = el.getAttribute('data-colors');
    if (!attr) return defaultColors;
    try {
      const vals = JSON.parse(attr);
      return vals.map((v) => {
        const c = (v || '').replace(' ', '');
        if (c.indexOf(',') === -1) {
          return getComputedStyle(document.documentElement).getPropertyValue(c) || c;
        }
        const parts = v.split(',');
        if (parts.length === 2) {
          return `rgba(${getComputedStyle(document.documentElement).getPropertyValue(parts[0])},${parts[1]})`;
        }
        return c;
      });
    } catch (e) {
      return defaultColors;
    }
  }

  function destroy(id) {
    if (charts[id]) {
      charts[id].destroy();
      delete charts[id];
    }
  }

  function renderApex(id, opts) {
    destroy(id);
    const el = document.getElementById(id);
    if (!el) return;
    opts.bar = opts.bar || {};
    opts.line = opts.line || {};
    opts.area = opts.area || {};
    opts.scatter = opts.scatter || {};
    opts.pie = opts.pie || {};
    opts.donut = opts.donut || {};
    opts.colors = sanitizeColors(opts.colors, Array.isArray(opts.series) ? opts.series.length : 1);
    opts.fill = opts.fill || { colors: opts.colors };
    opts.markers = opts.markers || { colors: opts.colors };
    const buckets = ['bar','candlestick','heatmap','treemap','rangeBar','rangeArea','bubble','scatter','line','area','pie','donut'];
    buckets.forEach((b) => {
      if (!opts[b]) opts[b] = {};
      if (!opts[b].colors) opts[b].colors = opts.colors;
    });
    if (!opts.chart) {
      opts.chart = { type: 'bar', height: 320, toolbar: { show: false } };
    } else if (!opts.chart.type) {
      opts.chart.type = 'bar';
    }
    if (!opts.series || !opts.series.length) {
      opts.series = [{ name: 'No data', data: [0] }];
    }
    try {
      charts[id] = new ApexCharts(el, opts);
      charts[id].render();
    } catch (err) {
      console.error('Apex render error', id, err);
    }
  }

  function renderDonut(id, labels, series, type) {
    const colors = sanitizeColors(getColors(id), series ? series.length : 1);
    const safeLabels = labels && labels.length ? labels : ['No data'];
    const safeSeries = Array.isArray(series) && series.length ? series : [0];
    renderApex(id, {
      chart: { type: type === 'pie' ? 'pie' : 'donut', height: 340, toolbar: { show: false } },
      series: safeSeries,
      labels: safeLabels,
      legend: { position: 'bottom' },
      dataLabels: { enabled: true },
      colors,
      fill: { colors },
      markers: { colors }
    });
  }

  function baseOptions(type, labels, series, colors, extra = {}) {
    const safeSeries = Array.isArray(series) && series.length ? series : [{ name: 'No data', data: (labels && labels.length ? labels : ['No data']).map(() => 0) }];
    return {
      series: safeSeries,
      chart: { type, height: extra.height || 320, stacked: type === 'bar', toolbar: { show: false } },
      stroke: { curve: 'smooth', width: 2 },
      dataLabels: { enabled: false },
      xaxis: { categories: labels || [] },
      colors: colors || defaultColors,
      fill: { colors: colors || defaultColors },
      markers: { colors: colors || defaultColors },
      legend: { position: 'top' },
      yaxis: { labels: { formatter: (val) => (val ?? 0).toString() }, min: 0 },
      ...extra
    };
  }

  function renderSeries(id, labels, series, type) {
    const colors = sanitizeColors(getColors(id), series ? series.length : 1);
    const safeLabels = labels && labels.length ? labels : ['No data'];
    const safeSeries = series && series.length ? series : [{ name: 'No data', data: safeLabels.map(() => 0) }];
    const t = (type === 'bar') ? 'bar' : (type === 'line' ? 'line' : 'area');
    const opts = baseOptions(t, safeLabels, safeSeries, colors, {
      height: 340,
      plotOptions: t === 'bar' ? { bar: { columnWidth: '50%' } } : undefined,
      fill: t === 'area' ? { type: 'solid', opacity: 0.15 } : undefined
    });
    renderApex(id, opts);
  }

  function renderAll() {
    if (!cached) return;
    const statusMap = {};
    (cached.staff_status_counts || []).forEach((row) => {
      statusMap[row.staff_status] = row.total;
    });
    document.getElementById('activeStaffCount').textContent = statusMap.active || 0;
    const liveRange = (typeof cached.range_on_leave !== 'undefined') ? cached.range_on_leave : null;
    const liveToday = (typeof cached.current_on_leave !== 'undefined') ? cached.current_on_leave : null;
    const onLeaveVal = (liveRange !== null) ? liveRange : (liveToday !== null ? liveToday : (statusMap.on_leave || 0));
    document.getElementById('onLeaveCount').textContent = onLeaveVal;
    document.getElementById('inactiveCount').textContent = statusMap.inactive || 0;
    const openLeave = (cached.leave_summary || []).filter((r) => (r.status || '').toLowerCase() !== 'approved')
      .reduce((sum, r) => sum + Number(r.total_requests || 0), 0);
    const openBadge = document.getElementById('openLeaveCount');
    if (openBadge) openBadge.textContent = openLeave;

    const defType = chartTypeDefault ? chartTypeDefault.value : 'bar';
    const safeType = (chartId, desired) => {
      const allowed = allowedTypes[chartId] || ['bar', 'line', 'area'];
      return allowed.includes(desired) ? desired : allowed[0];
    };
    const statusType = safeType('hrStatusChart', (document.querySelector('[data-chart="hrStatusChart"]') || {}).value || defType);
    const deptType = safeType('hrDeptChart', (document.querySelector('[data-chart="hrDeptChart"]') || {}).value || defType);
    const leaveTypeType = safeType('hrLeaveTypeChart', (document.querySelector('[data-chart="hrLeaveTypeChart"]') || {}).value || 'donut');
    const leaveTrendType = safeType('hrLeaveTrendChart', (document.querySelector('[data-chart="hrLeaveTrendChart"]') || {}).value || 'area');

    if (cached.staff_status_counts) {
      const labels = cached.staff_status_counts.map((r) => (r.staff_status || 'UNKNOWN').toUpperCase());
      const vals = cached.staff_status_counts.map((r) => Number(r.total || 0));
      if (statusType === 'bar' || statusType === 'line' || statusType === 'area') {
        renderSeries('hrStatusChart', labels, [{ name: 'Staff', data: vals }], statusType);
      } else {
        renderDonut('hrStatusChart', labels, vals, statusType);
      }
    }

    if (cached.headcount_by_department) {
      const top = cached.headcount_by_department.slice(0, 12);
      const labels = top.map((r) => r.department_name || 'Unassigned');
      const vals = top.map((r) => Number(r.total || 0));
      if (deptType === 'donut' || deptType === 'pie') {
        renderDonut('hrDeptChart', labels, vals, deptType);
      } else {
        renderSeries('hrDeptChart', labels, [{ name: 'Headcount', data: vals }], deptType);
      }
    }

    if (cached.leave_type_mix) {
      const labels = cached.leave_type_mix.map((r) => r.name || 'Unknown');
      const vals = cached.leave_type_mix.map((r) => Number(r.total || 0));
      if (leaveTypeType === 'bar') {
        renderSeries('hrLeaveTypeChart', labels, [{ name: 'Approved', data: vals }], 'bar');
      } else {
        renderDonut('hrLeaveTypeChart', labels, vals, leaveTypeType);
      }
    } else {
      if (leaveTypeType === 'bar') {
        renderSeries('hrLeaveTypeChart', ['No data'], [{ name: 'Approved', data: [0] }], 'bar');
      } else {
        renderDonut('hrLeaveTypeChart', ['No data'], [0], leaveTypeType);
      }
    }

    if (cached.leave_trend) {
      const labels = cached.leave_trend.map((r) => r.ym || 'Unknown');
      const vals = cached.leave_trend.map((r) => Number(r.total || 0));
      renderSeries('hrLeaveTrendChart', labels, [{ name: 'Approved', data: vals }], leaveTrendType);
    } else {
      renderSeries('hrLeaveTrendChart', ['No data'], [{ name: 'Approved', data: [0] }], leaveTrendType);
    }

    const headcountBody = document.getElementById('headcountBody');
    if (headcountBody) {
      if (!cached.headcount_by_department || !cached.headcount_by_department.length) {
        headcountBody.innerHTML = '<tr><td colspan="2" class="text-center text-muted">No data available</td></tr>';
      } else {
        headcountBody.innerHTML = cached.headcount_by_department.map((row) => `
          <tr>
            <td>${row.department_name || 'Unassigned'}</td>
            <td>${row.total}</td>
          </tr>
        `).join('');
      }
    }

    const leaveSummaryBody = document.getElementById('leaveSummaryBody');
    if (leaveSummaryBody) {
      if (!cached.leave_summary || !cached.leave_summary.length) {
        leaveSummaryBody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No data available</td></tr>';
      } else {
        leaveSummaryBody.innerHTML = cached.leave_summary.map((row) => `
          <tr>
            <td>${row.leave_type}</td>
            <td>${row.status}</td>
            <td>${row.total_requests}</td>
            <td>${row.total_days}</td>
          </tr>
        `).join('');
      }
    }

    const leaveRequestsBody = document.getElementById('leaveRequestsBody');
    if (leaveRequestsBody) {
      if (!cached.leave_requests_range || !cached.leave_requests_range.length) {
        leaveRequestsBody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No data available</td></tr>';
      } else {
        leaveRequestsBody.innerHTML = cached.leave_requests_range.map((row) => `
          <tr>
            <td>${row.staff_name}</td>
            <td>${row.leave_type}</td>
            <td>${row.date_range}</td>
            <td>${row.status}</td>
          </tr>
        `).join('');
      }
    }

    const range = cached.range || {};
    const start = range.start || range.from;
    const end = range.end || range.to;
    const label = (start && end) ? `${start} to ${end}` : '';
    if (rangeLabel) rangeLabel.textContent = label ? `Showing data from ${label}` : '';
  }

  function handleChartTypeChange(ev) {
    const select = ev.target.closest('.hr-chart-type');
    if (!select) return;
    const chartId = select.getAttribute('data-chart');
    const val = select.value;
    if (!chartId || !val) return;
    renderAll();
  }

  function loadData() {
    const range = getRange();
    const params = new URLSearchParams(range).toString();
    const url = `${apiUrl}?${params}`;
    fetch(url, { credentials: 'same-origin' })
      .then((r) => r.json())
      .then((data) => {
        if (!data) return;
        cached = data.data || data;
        renderAll();
      })
      .catch((err) => {
        console.error('HR report load error', err);
      });
  }

  function reset() {
    if (picker) {
      picker.clear();
    }
    if (chartTypeDefault) chartTypeDefault.value = 'bar';
    chartTypeSelectors.forEach((sel) => {
      const chart = sel.getAttribute('data-chart');
      const allowed = allowedTypes[chart] || ['bar'];
      sel.value = allowed[0];
    });
    cached = null;
    renderAll();
    loadData();
  }

  function init() {
    // Bail if the required controls are missing (page not loaded yet)
    if (!dateInput || !chartTypeDefault || !btnApply || !btnReset) {
      return;
    }
    picker = flatpickr(dateInput, {
      mode: 'range',
      dateFormat: 'Y-m-d',
      defaultDate: defaultRange().map(formatDate),
      onChange: () => {
        const range = getRange();
        if (rangeLabel) rangeLabel.textContent = `Showing data from ${range.start} to ${range.end}`;
      }
    });

    if (btnApply) btnApply.addEventListener('click', loadData);
    if (btnReset) btnReset.addEventListener('click', reset);
    chartTypeSelectors.forEach((sel) => sel.addEventListener('change', handleChartTypeChange));

    const range = getRange();
    if (rangeLabel) rangeLabel.textContent = `Showing data from ${range.start} to ${range.end}`;
    loadData();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
