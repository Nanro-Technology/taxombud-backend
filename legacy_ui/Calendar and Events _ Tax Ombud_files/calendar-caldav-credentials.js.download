/* eslint-disable */
(function () {
  function toggleMessage(el, message) {
    if (!el) return;
    el.textContent = message || '';
    el.classList.toggle('d-none', !message);
  }

  function setSubmitting(button, submitting) {
    if (!button) return;
    const label = button.querySelector('.label');
    const spinner = button.querySelector('.spinner-border');
    button.disabled = !!submitting;
    if (label) {
      label.classList.toggle('d-none', !!submitting);
    }
    if (spinner) {
      spinner.classList.toggle('d-none', !submitting);
    }
  }

  async function copyText(text) {
    if (!text) return false;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch (e) {}
    }
    const temp = document.createElement('textarea');
    temp.value = text;
    temp.setAttribute('readonly', 'readonly');
    temp.style.position = 'absolute';
    temp.style.left = '-9999px';
    document.body.appendChild(temp);
    temp.select();
    const copied = document.execCommand('copy');
    document.body.removeChild(temp);
    return copied;
  }

  document.addEventListener('DOMContentLoaded', function () {
    const config = window.calendarCaldavConfig || {};
    const apiBase = typeof url_root !== 'undefined' ? url_root : '../';
    const apiCreds = config.apiUrl || (apiBase + 'api/modules/calendar/caldav_credentials');
    const urlEl = document.getElementById('caldavUrl');
    const alertEl = document.getElementById('caldavAlert');
    const okEl = document.getElementById('caldavSuccess');
    const userEl = document.getElementById('caldavUser');
    const copyBtn = document.getElementById('copyCaldav');
    const form = document.getElementById('caldavForm');
    const pw = document.getElementById('caldavPassword');
    const btn = form ? form.querySelector('button[type="submit"]') : null;
    const modalEl = config.modalId ? document.getElementById(config.modalId) : null;
    if (!form || !pw) return;

    async function loadCreds() {
      try {
        const res = await fetch(apiCreds, {
          method: 'GET',
          credentials: 'same-origin'
        });
        const data = await res.json().catch(function () { return {}; });
        if (!res.ok) {
          throw new Error(data.error || data.message || 'Unable to load CalDAV credentials');
        }
        if (urlEl) urlEl.value = data.caldav_url || '';
        if (userEl) userEl.textContent = data.username ? ('Username: ' + data.username) : '';
      } catch (error) {
        if (urlEl) urlEl.value = '';
        toggleMessage(alertEl, error.message || 'Unable to load CalDAV credentials');
      }
    }

    if (copyBtn && urlEl) {
      copyBtn.addEventListener('click', async function () {
        const originalHtml = copyBtn.innerHTML;
        const copied = await copyText(urlEl.value || '');
        if (copied) {
          copyBtn.innerHTML = '<i class="ri-check-line me-1"></i>Copied';
          setTimeout(function () {
            copyBtn.innerHTML = originalHtml;
          }, 1200);
        }
      });
    }

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      toggleMessage(alertEl, '');
      toggleMessage(okEl, '');
      if (!pw.value) {
        toggleMessage(alertEl, 'Please enter a CalDAV password.');
        return;
      }

      setSubmitting(btn, true);
      try {
        const res = await fetch(apiCreds, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: pw.value })
        });
        const data = await res.json().catch(function () { return {}; });
        if (!res.ok) {
          throw new Error(data.error || data.message || 'Unable to save CalDAV password');
        }
        pw.value = '';
        toggleMessage(okEl, 'CalDAV password saved. Use the URL above with your email and this password.');
        loadCreds();
      } catch (error) {
        toggleMessage(alertEl, error.message || 'Unable to save CalDAV password');
      } finally {
        setSubmitting(btn, false);
      }
    });

    if (modalEl) {
      modalEl.addEventListener('shown.bs.modal', function () {
        toggleMessage(alertEl, '');
        toggleMessage(okEl, '');
        if (pw) pw.value = '';
        loadCreds();
      });
      return;
    }

    loadCreds();
  });
})();
