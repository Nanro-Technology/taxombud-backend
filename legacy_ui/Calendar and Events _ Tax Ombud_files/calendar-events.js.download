/* eslint-disable */
(function() {
      const calendarConfig = window.calendarEventsConfig || {};
      const apiBase = (typeof url_root !== 'undefined' ? url_root : '../');
      const apiMeetings = apiBase + 'api/modules/meetings/index';
      const apiMeetingDetail = apiBase + 'api/modules/meetings/detail';
      const apiCases = apiBase + 'api/modules/cases/index';
      const apiDepartments = apiBase + 'api/modules/departments/index';
      const apiShares = apiBase + 'api/modules/calendar/shares';
      const apiShareAgents = apiBase + 'api/modules/calendar/agents';
      const canCreate = Boolean(calendarConfig.canCreate);
      const BIRTHDAY_PREF_KEY = 'calendar_include_birthdays';
      let includeBirthdays = true;
      try {
        includeBirthdays = (window.localStorage && localStorage.getItem(BIRTHDAY_PREF_KEY)) !== '0';
      } catch (e) {}
      const calendarEl = document.getElementById('calendar');
      const eventModalEl = document.getElementById('eventModal');
      const eventModal = eventModalEl ? new bootstrap.Modal(eventModalEl) : null;
      const eventForm = document.getElementById('eventForm');
      const eventAlert = document.getElementById('eventAlert');
      const fields = {
        id: document.getElementById('eventId'),
        title: document.getElementById('eventTitle'),
        type: document.getElementById('eventType'),
        status: document.getElementById('eventStatus'),
        start: document.getElementById('eventStart'),
        end: document.getElementById('eventEnd'),
        location: document.getElementById('eventLocation'),
        link: document.getElementById('eventLink'),
        caseHidden: document.getElementById('eventCaseId'),
        caseSearch: document.getElementById('eventCaseSearch'),
        caseResults: document.getElementById('eventCaseResults'),
        notifyOwner: document.getElementById('eventNotifyOwner'),
        attendees: document.getElementById('eventAttendees'),
        notes: document.getElementById('eventNotes'),
        isPublic: document.getElementById('eventPublic'),
        reminder: document.getElementById('eventReminder'),
        owner: document.getElementById('eventOwner'),
        department: document.getElementById('eventDepartment'),
        saveBtn: document.getElementById('eventSaveBtn')
      };
      const shareModalEl = document.getElementById('sharedCalendarsModal');
      const shareModal = shareModalEl ? new bootstrap.Modal(shareModalEl) : null;
      const shareList = document.getElementById('shareList');
      const shareUserSelect = document.getElementById('shareUserSelect');
      const shareAccess = document.getElementById('shareAccess');
      const shareForm = document.getElementById('shareForm');
      const shareAlert = document.getElementById('shareAlert');

      function parseJsonSafe(resp) {
        return resp.text().then(text => {
          try { return { ok: resp.ok, json: text ? JSON.parse(text) : {}, raw: text }; }
          catch (e) { return { ok: resp.ok, json: null, raw: text }; }
        });
      }

      function showAlert(msg) {
        if (!eventAlert) return;
        eventAlert.textContent = msg || '';
        eventAlert.classList.toggle('d-none', !msg);
      }
      function setSaving(state) {
        const sp = fields.saveBtn?.querySelector('.spinner-border');
        const lbl = fields.saveBtn?.querySelector('.label');
        if (fields.saveBtn) fields.saveBtn.disabled = !!state;
        if (sp) sp.classList.toggle('d-none', !state);
        if (lbl) lbl.textContent = state ? 'Saving...' : 'Save';
      }
      function resetForm() {
        if (!eventForm) return;
        eventForm.reset();
        if (fields.id) fields.id.value = '';
        if (fields.status) fields.status.value = 'planned';
        if (fields.type) fields.type.value = '';
        if (fields.attendees) Array.from(fields.attendees.options).forEach(o => o.selected = false);
        if (fields.caseHidden) fields.caseHidden.value = '';
        if (fields.caseSearch) fields.caseSearch.value = '';
        if (fields.isPublic) fields.isPublic.checked = false;
        if (fields.notifyOwner) fields.notifyOwner.checked = false;
        if (fields.reminder) fields.reminder.value = '';
        if (fields.owner) fields.owner.value = '';
        if (fields.department) fields.department.value = '';
        if (fields.saveBtn) fields.saveBtn.disabled = false;
        toggleTypeFields();
        showAlert('');
      }
      function isoLocal(dt) {
        if (!dt) return '';
        const d = new Date(dt);
        const off = d.getTimezoneOffset();
        const local = new Date(d.getTime() - off * 60000);
        return local.toISOString().slice(0,16);
      }
      function normalizeDate(dt) {
        if (!dt) return '';
        const d = new Date(dt);
        if (isNaN(d)) return '';
        return d.toISOString().slice(0,19).replace('T',' ');
      }
      function colorForStatus(status) {
        switch ((status || '').toLowerCase()) {
          case 'planned': return '#7c69ef';
          case 'in_progress': return '#0dcaf0';
          case 'done': return '#28a745';
          case 'cancelled': return '#dc3545';
          case 'birthday': return '#f06595';
          default: return '#0d6efd';
        }
      }

      function updateBirthdayToggleUi() {
        const btn = document.getElementById('btnToggleBirthdays');
        if (!btn) return;
        btn.dataset.enabled = includeBirthdays ? '1' : '0';
        btn.innerHTML = includeBirthdays
          ? '<i class="ri-cake-3-line me-1"></i>Birthdays: On'
          : '<i class="ri-cake-3-line me-1"></i>Birthdays: Off';
        btn.classList.toggle('btn-soft-primary', includeBirthdays);
        btn.classList.toggle('btn-outline-primary', !includeBirthdays);
      }

      async function fetchEvents(info, success, failure) {
        try {
          const qs = new URLSearchParams({
            start: info.startStr,
            end: info.endStr,
            limit: '500',
            include_birthdays: includeBirthdays ? '1' : '0'
          });
          const res = await fetch(apiMeetings + '?' + qs.toString());
          const data = await res.json();
          if (!res.ok) throw new Error(data?.error || 'Unable to load meetings');
          const evts = (data.data || []).map(m => ({
            id: m.id,
            title: m.title || 'Meeting',
            start: m.start_at,
            end: m.end_at,
            allDay: !!m.all_day || !!m.is_birthday,
            editable: !m.is_birthday,
            extendedProps: m,
            backgroundColor: colorForStatus(m.status),
            borderColor: colorForStatus(m.status),
          }));
          success(evts);
        } catch (e) {
          failure(e);
        }
      }

      function toggleEventLoading(show) {
        const loader = document.getElementById('eventLoading');
        if (loader) loader.classList.toggle('d-none', !show);
      }

      function openModal(meeting) {
        resetForm();
        toggleEventLoading(false);
        if (meeting && fields.id) fields.id.value = meeting.id || '';
        if (fields.title) fields.title.value = meeting?.title || '';
        if (fields.type) fields.type.value = meeting?.type || '';
        // Default visibility: respect saved flag; otherwise default off
        if (fields.isPublic) {
          if (meeting?.is_public !== undefined) {
            fields.isPublic.checked = !!meeting.is_public;
          } else {
            fields.isPublic.checked = false;
          }
        }
        if (fields.status && meeting?.status) fields.status.value = meeting.status;
        if (fields.start && meeting?.start_at) fields.start.value = isoLocal(meeting.start_at);
        if (fields.end && meeting?.end_at) fields.end.value = isoLocal(meeting.end_at);
        if (fields.location) fields.location.value = meeting?.location || '';
        if (fields.link) fields.link.value = meeting?.vc_link || '';
        if (fields.caseHidden) fields.caseHidden.value = meeting?.case_id || '';
        const caseLabel = meeting?.case_number ? `Case ${meeting.case_number}${meeting.case_subject ? ' — ' + meeting.case_subject : ''}` : (meeting?.case_subject ? meeting.case_subject : '');
        if (fields.caseSearch) fields.caseSearch.value = caseLabel || '';
        if (fields.notes) fields.notes.value = meeting?.notes || '';
        if (fields.notifyOwner) {
          fields.notifyOwner.checked = !!meeting?.notify_owner;
        }
        if (fields.reminder) {
          if (meeting?.reminders_json) {
            try {
              const vals = JSON.parse(meeting.reminders_json);
              fields.reminder.value = Array.isArray(vals) ? vals.join(', ') : '';
            } catch (e) {
              fields.reminder.value = meeting?.reminder_minutes != null ? meeting.reminder_minutes : '';
            }
          } else {
            fields.reminder.value = meeting?.reminder_minutes != null ? meeting.reminder_minutes : '';
          }
        }
        if (fields.department) fields.department.value = '';
        if (fields.owner) {
          fields.owner.value = meeting?.owner_user_id ? String(meeting.owner_user_id) : '';
        }
        // (is_public already handled above)
        if (fields.attendees && Array.isArray(meeting?.attendees)) {
          const set = new Set(meeting.attendees.map(a => String(a)));
          Array.from(fields.attendees.options).forEach(o => { o.selected = set.has(o.value); });
        }
        // Join and case link buttons
        const joinBtn = document.getElementById('eventJoinLink');
        if (joinBtn) {
          if (meeting?.vc_link) {
            joinBtn.classList.remove('d-none');
            joinBtn.href = meeting.vc_link;
            joinBtn.target = '_blank';
          } else {
            joinBtn.classList.add('d-none');
            joinBtn.href = '#';
          }
        }
        const caseBtn = document.getElementById('eventCaseLink');
        if (caseBtn) {
          if (meeting?.case_id) {
            caseBtn.classList.remove('d-none');
            caseBtn.href = (typeof url_root !== 'undefined' ? url_root : '../') + 'studio/cases/view.kml?id=' + encodeURIComponent(meeting.case_id);
          } else {
            caseBtn.classList.add('d-none');
            caseBtn.href = '#';
          }
        }
        if (eventModal) eventModal.show();
        toggleTypeFields();
        if (fields.saveBtn) {
          const readOnly = meeting?.shared_access === 'view';
          fields.saveBtn.disabled = !!readOnly;
          if (readOnly) {
            showAlert('You have view-only access to this shared calendar.');
          }
        }
      }

      async function loadMeeting(id) {
        const res = await fetch(apiMeetingDetail + '?id=' + encodeURIComponent(id));
        const { ok, json, raw } = await parseJsonSafe(res);
        if (!ok) throw new Error(json?.error || raw || 'Unable to load meeting');
        return json;
      }

      async function saveMeeting(payload) {
        const isEdit = !!payload.id;
        const url = isEdit ? (apiMeetingDetail + '?id=' + encodeURIComponent(payload.id)) : apiMeetings;
        const method = isEdit ? 'PATCH' : 'POST';
        const body = JSON.stringify(payload);
        const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body });
        const { ok, json, raw } = await parseJsonSafe(res);
        const status = res.status;
        if (!ok) throw new Error(json?.error || raw || ('Unable to save (' + status + ')'));
        return { status, data: json, raw };
      }

      if (eventForm) {
        eventForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          showAlert('');
          setSaving(true);
          try {
            if (!fields.type?.value) {
              showAlert('Please select calendar type.');
              setSaving(false);
              return;
            }
            if (!fields.start?.value || !fields.end?.value) {
              showAlert('Start and end time are required.');
              setSaving(false);
              return;
            }
            // ensure end after start
            const startVal = new Date(fields.start.value);
            const endVal = new Date(fields.end.value);
            if (isNaN(startVal) || isNaN(endVal) || endVal <= startVal) {
              showAlert('End time must be after start time.');
              setSaving(false);
              return;
            }
            const attendees = fields.attendees ? Array.from(fields.attendees.selectedOptions).map(o => parseInt(o.value, 10)).filter(Boolean) : [];
            const reminderRaw = fields.reminder?.value ? String(fields.reminder.value) : '';
            const reminderVals = reminderRaw ? reminderRaw.split(',').map(v => parseInt(v.trim(), 10)).filter(v => Number.isFinite(v) && v > 0) : [];
            const payload = {
              id: fields.id?.value || undefined,
              title: fields.title?.value.trim(),
              type: fields.type?.value,
              status: fields.status?.value || 'planned',
              start_at: normalizeDate(fields.start?.value),
              end_at: normalizeDate(fields.end?.value),
              location: fields.location?.value.trim(),
              vc_link: fields.link?.value.trim(),
              case_id: fields.caseHidden?.value ? parseInt(fields.caseHidden.value, 10) : null,
              notify_owner: (fields.type?.value === 'meeting' && fields.notifyOwner?.checked) ? 1 : 0,
              attendees: (fields.type?.value === 'event') ? [] : attendees,
              notes: fields.notes?.value.trim(),
              is_public: fields.isPublic && fields.isPublic.checked ? 1 : 0,
              calendar_owner_user_id: fields.owner?.value ? parseInt(fields.owner.value, 10) : undefined,
              reminder_minutes: reminderVals.length ? reminderVals[0] : null,
              reminders_json: reminderVals.length ? reminderVals : null
            };
            if (fields.type?.value === 'meeting' && fields.department?.value) {
              payload.invite_department_id = parseInt(fields.department.value, 10);
            }
            const resp = await saveMeeting(payload);
            showAlert('');
            if (calendar) calendar.refetchEvents();
            if (eventModal) eventModal.hide();
          } catch (err) {
            showAlert(err.message || 'Unable to save');
          } finally {
            setSaving(false);
          }
        });
      }

      let calendar = null;
      if (calendarEl) {
        calendar = new FullCalendar.Calendar(calendarEl, {
          initialView: 'dayGridMonth',
          editable: canCreate,
          droppable: canCreate,
          selectable: canCreate,
          headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
          },
          events: fetchEvents,
          select: (info) => {
            if (!canCreate) return;
            openModal({ start_at: info.startStr, end_at: info.endStr, status: 'planned', type: '' });
          },
          eventReceive: async (info) => {
            if (!canCreate) { info.event.remove(); return; }
            const start = info.event.start;
            const durationMin = parseInt(info.draggedEl?.getAttribute('data-duration') || '60', 10);
            const end = info.event.end || new Date(start.getTime() + (isNaN(durationMin) ? 60 : durationMin) * 60000);
            await saveMeeting({
              title: info.event.title,
              start_at: normalizeDate(start),
              end_at: normalizeDate(end),
              status: 'planned',
              type: 'meeting',
              attendees: []
            });
            if (calendar) calendar.refetchEvents();
            info.event.remove(); // remove temp event
          },
          eventClick: async (info) => {
            if (info?.event?.extendedProps?.is_birthday) {
              return;
            }
            try {
              toggleEventLoading(true);
              if (eventModal) eventModal.show();
              const data = await loadMeeting(info.event.id);
              openModal(data);
            } catch (e) {
              showAlert(e.message || 'Unable to open meeting');
            } finally {
              toggleEventLoading(false);
            }
          },
          eventDrop: async (info) => {
            try {
              const startStr = normalizeDate(info.event.start);
              const endStr = normalizeDate(info.event.end || new Date(info.event.start.getTime() + 60*60000));
              await saveMeeting({ id: info.event.id, start_at: startStr, end_at: endStr });
            } catch (e) {
              info.revert();
            }
          },
          eventResize: async (info) => {
            try {
              const startStr = normalizeDate(info.event.start);
              const endStr = normalizeDate(info.event.end);
              await saveMeeting({ id: info.event.id, start_at: startStr, end_at: endStr });
            } catch (e) {
              info.revert();
            }
          }
        });
        calendar.render();
      }
      loadDepartments();

      // External draggable events
      if (canCreate && window.FullCalendar && FullCalendar.Draggable) {
        new FullCalendar.Draggable(document.getElementById('external-events'), {
          itemSelector: '.external-event',
          eventData: function(eventEl) {
            return {
              title: eventEl.getAttribute('data-title') || eventEl.innerText.trim(),
              duration: '01:00'
            };
          }
        });
      }

      const btnToday = document.getElementById('btnToday');
      if (btnToday && calendar) {
        btnToday.addEventListener('click', () => calendar.today());
      }
      updateBirthdayToggleUi();
      const btnBirthdays = document.getElementById('btnToggleBirthdays');
      if (btnBirthdays && calendar) {
        btnBirthdays.addEventListener('click', () => {
          includeBirthdays = !includeBirthdays;
          try {
            if (window.localStorage) {
              localStorage.setItem(BIRTHDAY_PREF_KEY, includeBirthdays ? '1' : '0');
            }
          } catch (e) {}
          updateBirthdayToggleUi();
          calendar.refetchEvents();
        });
      }
      const btnNew = document.getElementById('btnNewEvent');
      if (btnNew) btnNew.addEventListener('click', () => {
        toggleEventLoading(false);
        openModal({ status: 'planned', type: '', attendees: [] });
      });
      const btnShared = document.getElementById('btnSharedCalendars');
      if (btnShared) btnShared.addEventListener('click', () => {
        loadShares();
        loadShareUsers();
        if (shareModal) shareModal.show();
      });

      function toggleTypeFields() {
        const t = (fields.type?.value || '').toLowerCase();
        const isMeeting = t === 'meeting';
        document.querySelectorAll('.meeting-only').forEach(el => el.classList.toggle('d-none', !isMeeting));
        document.querySelectorAll('.type-common').forEach(el => el.classList.toggle('d-none', !t));
      }
      function loadDepartments() {
        if (!fields.department) return;
        fetch(apiDepartments + '?limit=200', { credentials: 'same-origin' })
          .then(parseJsonSafe)
          .then(({ ok, json }) => {
            if (!ok || !json?.data) return;
            fields.department.innerHTML = '<option value="">Select department</option>';
            json.data.forEach(d => {
              const opt = document.createElement('option');
              opt.value = d.id;
              opt.textContent = d.name;
              fields.department.appendChild(opt);
            });
          })
          .catch(() => {});
      }
      if (fields.type) {
        fields.type.addEventListener('change', toggleTypeFields);
        toggleTypeFields();
      }

      // Case search (basic)
      const caseSearchInput = document.getElementById('eventCaseSearch');
      const caseResults = document.getElementById('eventCaseResults');
      const caseHidden = document.getElementById('eventCaseId');
      const caseStatus = document.getElementById('eventCaseSearchStatus');
      function debounce(fn, wait) {
        let t;
        return function(...args) {
          clearTimeout(t);
          t = setTimeout(() => fn.apply(this, args), wait);
        };
      }
      function setCaseStatus(msg, isError) {
        if (!caseStatus) return;
        caseStatus.textContent = msg || '';
        caseStatus.classList.toggle('text-danger', !!isError);
        caseStatus.classList.toggle('text-muted', !isError);
      }
      async function searchCases() {
        const q = caseSearchInput.value.trim();
        if (q.length < 4) {
          if (caseResults) caseResults.classList.add('d-none');
          setCaseStatus('Enter 4 or more characters to search.', false);
          return;
        }
        setCaseStatus('Searching...', false);
        try {
          const res = await fetch(apiCases + '?' + new URLSearchParams({ q, limit: 5 }).toString());
          const { ok, json, raw } = await parseJsonSafe(res);
          if (!ok) throw new Error(json?.error || raw || 'Search failed');
          const list = json?.data || json || [];
          if (!caseResults) return;
          caseResults.innerHTML = '';
          if (!list.length) {
            caseResults.classList.add('d-none');
            setCaseStatus('No result found.', true);
            return;
          }
          list.slice(0,5).forEach(c => {
            const a = document.createElement('a');
            a.href = 'javascript:void(0);';
            a.className = 'list-group-item list-group-item-action';
            a.textContent = `Case ${c.case_number || c.id} — ${c.subject || ''}`;
            a.onclick = () => {
              if (caseHidden) caseHidden.value = c.id;
              caseSearchInput.value = a.textContent;
              const caseSelected = document.getElementById('eventCaseSelected');
              if (caseSelected) caseSelected.textContent = a.textContent;
              setCaseStatus('', false);
              caseResults.classList.add('d-none');
            };
            caseResults.appendChild(a);
          });
          caseResults.classList.remove('d-none');
          setCaseStatus('', false);
        } catch (e) {
          if (caseResults) caseResults.classList.add('d-none');
          setCaseStatus('No result found.', true);
        }
      }
      if (caseSearchInput) {
        caseSearchInput.addEventListener('input', debounce(searchCases, 400));
      }

      function showShareAlert(msg) {
        if (!shareAlert) return;
        shareAlert.textContent = msg || '';
        shareAlert.classList.toggle('d-none', !msg);
      }
      async function loadShareUsers() {
        if (!shareUserSelect) return;
        try {
          const res = await fetch(apiShareAgents);
          const { ok, json, raw } = await parseJsonSafe(res);
          if (!ok) throw new Error(json?.error || raw || 'Unable to load users');
          const data = json || {};
          const list = data?.data || [];
          shareUserSelect.innerHTML = '<option value="">Select user</option>';
          list.forEach((u) => {
            const opt = document.createElement('option');
            opt.value = u.user_id || u.id;
            opt.textContent = u.display_name || u.name || ('User #' + (u.user_id || u.id));
            shareUserSelect.appendChild(opt);
          });
        } catch (e) {
          showShareAlert('Unable to load users.');
        }
      }
      async function loadShares() {
        if (!shareList) return;
        shareList.innerHTML = '<tr><td colspan="3" class="text-muted text-center">Loading...</td></tr>';
        try {
          const res = await fetch(apiShares);
          const { ok, json, raw } = await parseJsonSafe(res);
          if (!ok) throw new Error(json?.error || raw || 'Unable to load shares');
          const data = json || {};
          const list = Array.isArray(data?.owned) ? data.owned : (data?.shared || []);
          if (!list.length) {
            shareList.innerHTML = '<tr><td colspan="3" class="text-muted text-center">No shared calendars yet.</td></tr>';
            return;
          }
          shareList.innerHTML = '';
          list.forEach((s) => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td>${s.shared_with_name || s.owner_name || ('User #' + (s.shared_with_user_id || s.owner_user_id))}</td>
              <td class="text-capitalize">${s.access_level || 'view'}</td>
              <td class="text-end">
                <button class="btn btn-sm btn-soft-danger" data-id="${s.id}">Revoke</button>
              </td>`;
            shareList.appendChild(tr);
          });
        } catch (e) {
          shareList.innerHTML = '<tr><td colspan="3" class="text-danger text-center">Unable to load shares.</td></tr>';
        }
      }
      async function loadShareOptions() {
        if (!fields.owner) return;
        try {
          const res = await fetch(apiShares);
          const data = await res.json();
          const list = data?.shared || [];
          fields.owner.innerHTML = '<option value="">My Calendar</option>';
          list.forEach((s) => {
            if (s.access_level !== 'edit') return;
            const opt = document.createElement('option');
            opt.value = s.owner_user_id || '';
            opt.textContent = (s.owner_name || 'Owner') + ' (shared)';
            fields.owner.appendChild(opt);
          });
        } catch (e) {
        }
      }
      loadShareOptions();

      if (shareForm) {
        shareForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          showShareAlert('');
          const uid = shareUserSelect?.value;
          const access = shareAccess?.value || 'view';
          if (!uid) {
            showShareAlert('Select a user to share with.');
            return;
          }
          try {
            const res = await fetch(apiShares, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ shared_with_user_id: parseInt(uid, 10), access_level: access })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data?.error || 'Unable to share');
            if (shareUserSelect) shareUserSelect.value = '';
            if (shareAccess) shareAccess.value = 'view';
            await loadShares();
            await loadShareOptions();
          } catch (err) {
            showShareAlert(err.message || 'Unable to share');
          }
        });
      }
      if (shareList) {
        shareList.addEventListener('click', async (e) => {
          const btn = e.target.closest('button[data-id]');
          if (!btn) return;
          const id = btn.getAttribute('data-id');
          if (!id) return;
          btn.disabled = true;
          try {
            const res = await fetch(apiShares + '?id=' + encodeURIComponent(id), { method: 'DELETE' });
            const data = await res.json();
            if (!res.ok) throw new Error(data?.error || 'Unable to revoke');
            await loadShares();
            await loadShareOptions();
          } catch (err) {
            showShareAlert(err.message || 'Unable to revoke');
          } finally {
            btn.disabled = false;
          }
        });
      }

      const delBtn = document.getElementById('eventDeleteBtn');

      if (delBtn) {
        delBtn.addEventListener('click', async () => {
          if (!fields.id?.value) {
            showAlert('No event loaded to delete.');
            return;
          }
          const ok = await window.crmUiConfirm('Are you sure you want to delete this event/meeting?', 'Delete Event/Meeting', {
            okText: 'Delete',
            cancelText: 'Cancel',
            variant: 'danger',
            icon: 'warning'
          });
          if (!ok) return;
          delBtn.disabled = true;
          try {
            const res = await fetch(apiMeetingDetail + '?id=' + encodeURIComponent(fields.id.value), { method: 'DELETE' });
            const { ok, json, raw } = await parseJsonSafe(res);
            if (!ok) throw new Error(json?.error || raw || 'Unable to delete');
            if (calendar) calendar.refetchEvents();
            if (eventModal) eventModal.hide();
          } catch (e) {
            showAlert(e.message || 'Unable to delete');
          } finally {
            delBtn.disabled = false;
          }
        });
      }

    })();
