# ──────────────────────────────────────────────────────────────────────────────
# Tax Ombud Backend Production Environment Variables Template (.env)
# Rename this file to '.env' on the VPS and configure the actual values.
# ──────────────────────────────────────────────────────────────────────────────

# Docker and Ports Configuration
DOCKER_IMAGE=ghcr.io/your-github-username/taxombud-api:latest
API_PORT=5000
MYSQL_PORT=3306
REDIS_PORT=6379

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=ChangeThisToASecureRootPassword123!
MYSQL_DATABASE=taxombud_db
MYSQL_USER=taxombud_user
# Change this to a secure user password
MYSQL_PASSWORD=ChangeThisToASecureUserPassword123!

