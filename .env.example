# SMTP Settings for Emails
SMTP_HOST=mail.ksmlagosmetro.com.ng
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=emailsend@ksmlagosmetro.com.ng
SMTP_PASSWORD=Nanrotech@1
SMTP_FROM_ADDRESS=no-reply@ksmlagosmetro.com.ng
SMTP_FROM_NAME="Tax Ombud System"

# CORS Configuration
# Set the domain of your frontend app here.
# CORS_ALLOWED_ORIGIN_0 should point to the production frontend URL.
CORS_ALLOWED_ORIGIN_0=http://YOUR_VPS_IP_OR_FRONTEND_DOMAIN
CORS_ALLOWED_ORIGIN_1=http://localhost:5173
