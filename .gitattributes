# Handle line endings automatically for files Git detects as text
# and leave all other files untouched.
* text=auto

# C# source files
*.cs     text eol=crlf
*.cshtml text eol=crlf
*.csproj text eol=crlf
*.sln    text eol=crlf
*.props  text eol=crlf
*.targets text eol=crlf

# JSON / YAML / XML config
*.json   text eol=crlf
*.xml    text eol=crlf
*.yaml   text eol=crlf
*.yml    text eol=crlf
*.toml   text eol=crlf

# Markdown / Text
*.md     text eol=crlf
*.txt    text eol=crlf

# Shell scripts — keep LF even on Windows
*.sh     text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Docker-compose
docker-compose*.yml text eol=lf

# Binary files — never touch
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.docx   binary
*.xlsx   binary
*.zip    binary
*.nupkg  binary
*.dll    binary
*.exe    binary
*.pdb    binary
